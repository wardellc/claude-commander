{
  // The page (src/) and its unit tests (test/). The e2e suite has its own
  // tsconfig (e2e/tsconfig.json): it runs under Node + Playwright, not a browser.
  //
  // esbuild bundles src/ for the browser; the unit tests run the same .ts files
  // directly under `node --test`, which strips types without a compile step. That
  // is why imports carry explicit `.ts` extensions (allowImportingTsExtensions)
  // and why only erasable syntax is allowed (no enums, namespaces or parameter
  // properties — Node's stripper rejects them).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
